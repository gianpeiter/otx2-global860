#!/bin/bash

# Required package:
# sudo apt install moreutils -y
#
# If the script was edited on Windows:
# sudo apt install dos2unix -y
# dos2unix restart.sh

readonly BINARY_NAME="theotxserver"

MYSQL_USER="mysql_user"
MYSQL_PASS="mysql_password"
MYSQL_DATABASE="database"

readonly LOG_DIR="logs/restart"
readonly CONSOLE_DIR="$LOG_DIR/console"
readonly CRASH_DIR="$LOG_DIR/crash"
readonly BACKUP_DIR="$LOG_DIR/mysql_backup"

mkdir -p "$CONSOLE_DIR"
mkdir -p "$CRASH_DIR"
mkdir -p "$BACKUP_DIR"

ulimit -c unlimited

if [ ! -f "./$BINARY_NAME" ]; then
    echo "Binary not found: $BINARY_NAME"
    exit 1
fi

while :; do

    DATE_NOW=$(date '+%Y-%m-%d_%H-%M')
    CURRENT_DAY=$(date '+%Y-%m-%d')

    BACKUP_FILE="$BACKUP_DIR/${DATE_NOW}.sql"
    LOG_FILE="$CONSOLE_DIR/console_${CURRENT_DAY}.log"
    CRASH_NAME="$DATE_NOW"

    mysqldump -u "$MYSQL_USER" -p"$MYSQL_PASS" "$MYSQL_DATABASE" > "$BACKUP_FILE" 2>/dev/null

	find "$CONSOLE_DIR/" -name '*.log' ! -name "console_${CURRENT_DAY}.log" -mtime +3 -exec gzip -f {} \;
    find "$CRASH_DIR/" -name '*.bin' -mtime +3 -exec gzip -f {} \;
    find "$CRASH_DIR/" -name '*.core' -mtime +3 -exec gzip -f {} \;
    find "$BACKUP_DIR/" -name '*.sql' -mtime +3 -exec gzip -f {} \;

    find "$BACKUP_DIR/" -name '*.gz' -mtime +30 -delete

    cp -- "$BINARY_NAME" "$CRASH_DIR/${CRASH_NAME}.bin"

    echo "Starting server..."

    stdbuf -o 0 "./$BINARY_NAME" 2>&1 \
        | ts '%Y-%m-%d %H:%M:%S' \
        | tee -a "$LOG_FILE"

    [ -f core ] && mv core "$CRASH_DIR/${CRASH_NAME}.core"

    echo "Restarting in 3 seconds..."
    sleep 3

done